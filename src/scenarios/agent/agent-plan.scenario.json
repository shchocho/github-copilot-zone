            { "t": "", "diff": "add" },
            { "t": "export interface DailyReport { date: string; avg: number; max: number; min: number; count: number }", "diff": "add" },
            { "t": "", "diff": "add" },
            { "t": "/** 하루치 측정값 요약. 센서가 없으면 null, 값이 없는 날은 count 0 */", "diff": "add" },
            { "t": "export async function dailyReport(sensorId: string, date: string): Promise<DailyReport | null> {", "diff": "add" },
            { "t": "  const rows = await latestReadings(sensorId);", "diff": "add" },
            { "t": "  if (!rows) return null;", "diff": "add" },
            { "t": "  const day = rows.filter(r => r.at.startsWith(date));", "diff": "add" },
            { "t": "  if (!day.length) return { date, avg: 0, max: 0, min: 0, count: 0 };", "diff": "add" },
            { "t": "  const [b] = bucketize(day, 24 * 60);", "diff": "add" },
            { "t": "  return { date, avg: b.avg, max: b.max, min: Math.min(...day.map(r => r.value)), count: b.count };", "diff": "add" },
            { "t": "}", "diff": "add" }
